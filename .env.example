# API Keys for LLM providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Simulation settings
SIM_UPDATE_RATE=10  # Hz
SIM_VISUALIZATION=true

# LLM settings
LLM_PROVIDER=anthropic  # Options: anthropic, openai
LLM_MODEL=claude-sonnet-4-20250514  # or gpt-4, etc.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# Context management
MAX_CONTEXT_TOKENS=8000
CONTEXT_COMPRESSION_THRESHOLD=6000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/simulation.log
